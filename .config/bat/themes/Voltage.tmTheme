<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Voltage — bat syntax theme. Palette: themes/voltage.md.

  This also themes delta, which has no syntax theme of its own: it renders
  through bat's highlighting engine and reads $BAT_THEME when --syntax-theme
  isn't passed.

  bat does not read a .tmTheme directly — it reads a binary cache. After
  editing this file, run `bat cache --build` (install.sh does it on setup).
  Verify with `bat --list-themes | grep Voltage`.

  The uuid is fixed rather than freshly generated so a rebuild on another
  machine produces the same theme identity.
-->
<plist version="1.0">
<dict>
  <key>name</key>
  <string>Voltage</string>
  <key>semanticClass</key>
  <string>theme.dark.voltage</string>
  <key>uuid</key>
  <string>7f3c1a94-0d2e-4b8a-9f61-2c5ed70fb418</string>
  <key>colorSpaceName</key>
  <string>sRGB</string>
  <key>settings</key>
  <array>

    <!-- Editor / UI base -->
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key><string>#0F0D0E</string>
        <key>foreground</key><string>#E7E7E7</string>
        <key>caret</key><string>#F712FF</string>
        <key>selection</key><string>#2A2427</string>
        <key>selectionForeground</key><string>#E7E7E7</string>
        <key>lineHighlight</key><string>#1C191A</string>
        <key>invisibles</key><string>#393A3D</string>
        <key>gutter</key><string>#0F0D0E</string>
        <key>gutterForeground</key><string>#6B6B6B</string>
      </dict>
    </dict>

    <!-- Comments -->
    <dict>
      <key>name</key><string>Comment</string>
      <key>scope</key><string>comment, punctuation.definition.comment</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#6B6B6B</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

    <!-- Strings -->
    <dict>
      <key>name</key><string>String</string>
      <key>scope</key><string>string, punctuation.definition.string</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#FCF58D</string></dict>
    </dict>
    <dict>
      <key>name</key><string>String interpolation / escapes</string>
      <key>scope</key><string>constant.character.escape, string.regexp, punctuation.section.embedded, meta.embedded</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#17D5DF</string></dict>
    </dict>

    <!-- Constants and numbers -->
    <dict>
      <key>name</key><string>Number / constant</string>
      <key>scope</key><string>constant.numeric, constant.language, constant.character, constant.other</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#EB43F4</string></dict>
    </dict>

    <!-- Variables -->
    <dict>
      <key>name</key><string>Variable</string>
      <key>scope</key><string>variable, variable.other, meta.definition.variable</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#E7E7E7</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Parameter / member</string>
      <key>scope</key><string>variable.parameter, variable.other.member, entity.name.variable.parameter</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#FF9A4D</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Language variable (this, self)</string>
      <key>scope</key><string>variable.language</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#EB43F4</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

    <!-- Keywords and storage -->
    <dict>
      <key>name</key><string>Keyword</string>
      <key>scope</key><string>keyword, keyword.control, storage, storage.modifier</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#EB43F4</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Operator</string>
      <key>scope</key><string>keyword.operator, punctuation.separator, punctuation.terminator, punctuation.accessor</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#17D5DF</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Storage type</string>
      <key>scope</key><string>storage.type, keyword.type</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#5CC9F5</string></dict>
    </dict>

    <!-- Functions -->
    <dict>
      <key>name</key><string>Function name</string>
      <key>scope</key><string>entity.name.function, meta.function-call, support.function, meta.require</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#B3E053</string>
        <key>fontStyle</key><string>bold</string>
      </dict>
    </dict>

    <!-- Types and classes -->
    <dict>
      <key>name</key><string>Class / type</string>
      <key>scope</key><string>entity.name.class, entity.name.type, entity.name.struct, entity.name.enum, entity.name.namespace, entity.other.inherited-class, support.class, support.type</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#5CC9F5</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Support constant</string>
      <key>scope</key><string>support.constant, support.variable</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#EB43F4</string></dict>
    </dict>

    <!-- Markup / tags -->
    <dict>
      <key>name</key><string>Tag</string>
      <key>scope</key><string>entity.name.tag, punctuation.definition.tag</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#EB43F4</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Attribute name</string>
      <key>scope</key><string>entity.other.attribute-name, meta.attribute</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#FF9A4D</string></dict>
    </dict>

    <!-- Keys in JSON/YAML/TOML — the most-read case for `bat` on config files -->
    <dict>
      <key>name</key><string>Mapping key</string>
      <key>scope</key><string>support.type.property-name, meta.mapping.key string, entity.name.tag.yaml, keyword.key</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#5CC9F5</string></dict>
    </dict>

    <!-- Invalid -->
    <dict>
      <key>name</key><string>Invalid</string>
      <key>scope</key><string>invalid, invalid.illegal</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#0F0D0E</string>
        <key>background</key><string>#FF4D5E</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Deprecated</string>
      <key>scope</key><string>invalid.deprecated</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#0F0D0E</string>
        <key>background</key><string>#FF9A4D</string>
      </dict>
    </dict>

    <!-- Markdown -->
    <dict>
      <key>name</key><string>Heading</string>
      <key>scope</key><string>markup.heading, entity.name.section</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#B3E053</string>
        <key>fontStyle</key><string>bold</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Bold</string>
      <key>scope</key><string>markup.bold</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#FF9A4D</string>
        <key>fontStyle</key><string>bold</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Italic</string>
      <key>scope</key><string>markup.italic</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#FF9A4D</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Link</string>
      <key>scope</key><string>markup.underline.link, string.other.link</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#5CC9F5</string>
        <key>fontStyle</key><string>underline</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Raw / code span</string>
      <key>scope</key><string>markup.raw, markup.inline.raw</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#17D5DF</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Quote</string>
      <key>scope</key><string>markup.quote</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#6B6B6B</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>List bullet</string>
      <key>scope</key><string>markup.list punctuation.definition.list_item, punctuation.definition.list.begin</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#EB43F4</string></dict>
    </dict>

    <!-- Diff — this is what delta renders through -->
    <dict>
      <key>name</key><string>Diff inserted</string>
      <key>scope</key><string>markup.inserted, source.diff.inserted, meta.diff.inserted</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#B3E053</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Diff deleted</string>
      <key>scope</key><string>markup.deleted, source.diff.deleted, meta.diff.deleted</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#FF4D5E</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Diff changed</string>
      <key>scope</key><string>markup.changed, source.diff.changed</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#FCF58D</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Diff header / range</string>
      <key>scope</key><string>meta.diff.header, meta.diff.range, meta.diff.index</string>
      <key>settings</key>
      <dict><key>foreground</key><string>#17D5DF</string></dict>
    </dict>

  </array>
</dict>
</plist>
