# fzf, and bat, lsd, fd, zoxide, git-delta, ripgrep and vivid below, are back
# here after a stretch as zinit gh-r binaries. Homebrew copies got installed
# anyway, so each tool existed twice: interactive shells ran zinit's once its
# turbo load finished, while scripts and agent tool calls, which never load
# zinit, ran Homebrew's. delta had already split (zinit 0.19.2, Homebrew
# 0.20.1), the same shape as the atuin break described at its entry. One owner
# for every CLI binary, and it has to be the one every non-interactive caller
# can see. It also takes zinit's eager plugin load for fzf, zoxide and vivid
# off the startup path.
brew "fzf"
brew "git-lfs"
brew "httpie"
brew "jq"
brew "m-cli"
brew "mas"
brew "ssh-copy-id"
brew "terminal-notifier"
brew "task"
brew "fzy"
brew "tree"
brew "mycli"
brew "gh"
brew "carapace"
brew "colordiff"
brew "ranger"
brew "htop"
brew "go"
brew "neovim"
brew "gitui"
brew "pinentry-mac"
brew "fortune"
brew "figlet"
brew "lolcat"
brew "ccat"
brew "navi"
brew "ffmpeg"
