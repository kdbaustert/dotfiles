{
  "model": "opus",
  "effortLevel": "medium",
  "bashOutputMaxChars": 15000,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/notify.sh" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/search-excludes.sh" },
          { "type": "command", "command": "$HOME/.claude/hooks/command-guard.sh" }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/resume-after-limit.sh" }]
      }
    ]
  },
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "15000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "15000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "15"
  },
  "skillOverrides": {
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:setup-writing-style": "off",
    "anthropic-skills:pdf": "name-only",
    "anthropic-skills:deep-research": "name-only",
    "anthropic-skills:skill-creator": "name-only",
    "anthropic-skills:chrome-browser": "name-only",
    "anthropic-skills:computer-use": "name-only",
    "anthropic-skills:built-in-browser": "name-only",
    "dataviz": "name-only",
    "claude-api": "name-only",
    "artifact-design": "name-only",
    "artifact-diagramming": "name-only",
    "artifact-capabilities": "name-only",
    "code-review": "name-only",
    "update-config": "name-only"
  }
}
