# fzf, and bat, lsd, fd, zoxide, git-delta, ripgrep and vivid below, come from
# Homebrew and not from zinit gh-r binaries. With both installed, each tool
# exists twice: interactive shells run zinit's once its turbo load finishes,
# while scripts and agent tool calls, which never load zinit, run Homebrew's.
# The two versions drift apart (delta at 0.19.2 from zinit against 0.20.1
# from Homebrew), the same shape as the atuin break described at its entry.
# Each CLI binary
# needs one owner, and it has to be the one every non-interactive caller can
# see. This also keeps zinit's eager plugin load for fzf, zoxide and vivid off
# the startup path.
brew "fzf"
brew "git-lfs"
brew "httpie"
brew "jq"
brew "m-cli"
brew "mas"
brew "ssh-copy-id"
brew "terminal-notifier"
brew "task"
brew "fzy"
brew "tree"
brew "mycli"
brew "gh"
brew "carapace"
brew "colordiff"
brew "ranger"
brew "htop"
brew "go"
brew "neovim"
brew "gitui"
brew "pinentry-mac"
brew "fortune"
brew "figlet"
brew "lolcat"
brew "ccat"
brew "navi"
brew "ffmpeg"
# bat, lsd, fd, zoxide, git-delta, ripgrep: see the fzf entry.
brew "bat"
brew "ox"
brew "mdcat"
brew "xplr"
brew "glow"
brew "lsd"
brew "fd"
brew "sqlite"
brew "zlib"
brew "zoxide"
brew "git-delta"
brew "lazygit"
brew "eza"
brew "assh"
brew "procs"
brew "ripgrep"
# ast-grep: structural code search. Call it as `ast-grep`; the short `sg`
# alias still ships but prints a deprecation warning from 0.51. It matches on
# the syntax tree, so a search for a call skips comments, strings and
# look-alike names that rg can't tell apart. Declared so a fresh box gets it.
brew "ast-grep"
# typescript-language-server: also installed as a pnpm global by
# setup/pnpm.sh, and this copy comes first on PATH. It doesn't fix Claude
# Code's LSP tool failing on JS/TS in projects with no typescript of their own:
# it pulls in Homebrew's `typescript` formula, which is 7.x, and the server
# needs a tsserver.js that 7.x doesn't ship. It stays anyway. Side effect:
# Homebrew's tsc 7 shadows the pnpm tsc that setup/pnpm.sh holds at 6 wherever
# /opt/homebrew/bin comes first on PATH.
brew "typescript-language-server"
brew "nnn"
# node: the default Node here. nvm's node (see zsh/zinit.zsh) only reaches
# interactive shells, so this is what scripts and tool calls resolve. Without it declared,
# `brew bundle` on a fresh box produces a shell with pnpm but no node.
brew "node"
# python: the python3 that setup/lib.sh's settings merges run. The Codex one
# needs tomllib (3.11+), which macOS's /usr/bin/python3 (3.9) lacks. Relying on
# it arriving as a dependency of openssh or ranger would leave the merge to
# Apple's copy if both went away, and Apple's copy fails it every run.
brew "python"
brew "pnpm"
# direnv: per-directory environments, which here means a project's Nix dev
# shell: ghostty, rio and kennybdev each carry an .envrc saying `use flake`.
# The caching half, nix-direnv, is not a formula; .config/direnv/direnvrc
# fetches it pinned and checksummed. The zsh hook is the zcache line in .zshrc.
brew "direnv"
# vivid: see the fzf entry.
brew "vivid"
brew "imagemagick"
brew "nss"
# shfmt: also .claude/hooks/command-guard.sh parses every Bash call with it,
# and the guard lets everything through when it is missing.
brew "shfmt"
brew "shellcheck"
# stylua: Lua formatter. Declared here rather than left to Mason because
# .config/lvim wires it into none-ls, which shells out to PATH: a Mason copy
# would live under ~/.local/share and vanish with the editor's runtime.
brew "stylua"
# atuin: shell history. It comes from Homebrew and not from a zinit gh-r
# binary, which puts zinit's plugin machinery on the startup critical path and
# leaves two copies installed once a Homebrew one lands anyway. With two
# copies, the launchd daemon can run the Homebrew build (18.24.2) while the
# shell hooks call zinit's (18.22.0); the daemon then rejects every
# `atuin history end` and nothing is recorded. One install avoids that, and
# /opt/homebrew/bin/atuin is a link that survives `brew upgrade`, so the
# daemon's plist stays valid.
# install.sh's sync_atuin_daemon keeps the plist on it. Ignore the formula's
# `brew services start atuin` caveat: atuin's autostart already runs the daemon
# as sh.atuin.daemon, and a brew service would be a second one on the same
# socket.
brew "atuin"
# starship: the prompt. Not installed here: .zshrc runs the official
# installer into ~/.local/bin the first time a shell finds it missing, so that
# script is its one updater. Declaring it here as well makes `brew bundle
# check` fail on every machine where the installer has already run, and a
# `brew bundle install` would put a second copy on PATH. It stays here as a
# commented line so the package isn't lost from this list.
# brew "starship"
brew "poppler"
brew "sevenzip"
# zstd: provides unzstd, which install.sh needs to unpack the pay-respects
# release (it ships .tar.zst only). Declared because a script depends on it,
# rather than leaving it as a transitive dep of curl/imagemagick/etc.
brew "zstd"
brew "helix"
brew "yazi"
brew "btop"
brew "fastfetch"
brew "firebase-cli"
brew "zig"
# iris: inline completion overlay (IntelliSense for the prompt). Config and
# theme live in .config/iris and are symlinked by install.sh; the autostart hook
# is in .zshrc. The tap is the author's own, and is the only distribution
# channel that isn't `curl | sh` or a self-updating binary, which is also why
# [updater] is switched off in config.toml: brew owns this binary, so letting
# iris rewrite its own Cellar path would desync `brew upgrade`.
brew "versenilvis/iris/iris"
