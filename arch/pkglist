# --- command-not-found ------------------------------------------------------
# Arch's equivalent of Homebrew's handler; zsh/os/linux-interactive.zsh sources
# the script this ships. The files database needs `pkgfile -u` once, which
# install-linux.sh runs.
pkgfile

# --- Notifications ----------------------------------------------------------
# libnotify provides notify-send, which is what zsh-auto-notify (zsh/zinit.zsh)
# and .claude/hooks/notify.sh both use on this platform. Without it the plugin
# prints a warning on every shell start.
libnotify

# --- Clipboard --------------------------------------------------------------
# Both, because zsh/os/linux-interactive.zsh picks per session: wl-clipboard
# under Wayland, xclip under X11. Installing only one makes `pbcopy` fail in
# whichever session type you did not plan for.
wl-clipboard
xclip
xdg-utils

