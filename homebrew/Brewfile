# node — the default Node here. nvm is loaded (see zsh/zinit.zsh) but manages no
# versions, so this is what actually resolves. It was installed by hand and left
# undeclared, meaning `brew bundle` on a fresh box produced a shell with pnpm but
# no node; declare it so that stays reproducible.
brew "node"
brew "pnpm"
brew "vivid"
brew "imagemagick"
brew "nss"
brew "shfmt"
brew "shellcheck"
brew "atuin"
# starship — the prompt. Previously fetched as a gh-r binary by zinit, which
# forced zinit to load eagerly (a prompt can't be turbo-deferred) and put ~16ms
# of plugin machinery on the critical path. Declared here so it's installed like
# every other CLI binary; zsh/zinit.zsh no longer mentions it.
brew "starship"
brew "poppler"
brew "sevenzip"
# zstd — provides unzstd, which install.sh needs to unpack the pay-respects
# release (it ships .tar.zst only). Previously present merely as a transitive
# dep of curl/imagemagick/etc; declare it now that a script depends on it.
brew "zstd"
brew "helix"
brew "yazi"
brew "btop"
# clamav — on-demand AV scanner. Configs live in clamav/ and are symlinked into
