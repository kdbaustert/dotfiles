# ast-grep — structural code search. Call it as `ast-grep`; the short `sg`
# alias still ships but prints a deprecation warning as of 0.51. It matches on
# the syntax tree, so a search for a call skips comments, strings and
# look-alike names that rg can't tell apart. It was installed by hand and left
# undeclared; declared now so a fresh box gets it.
brew "ast-grep"
# typescript-language-server — also installed as a pnpm global by
# setup/pnpm.sh, and this copy comes first on PATH. It was tried as the fix
# for Claude Code's LSP tool failing on JS/TS in projects with no typescript of
# their own, and it isn't one: it pulls in Homebrew's `typescript` formula,
# which is 7.x, and the server needs a tsserver.js that 7.x no longer ships.
# Kept anyway. Side effect: Homebrew's tsc 7 now shadows the pnpm tsc that
# setup/pnpm.sh holds at 6 wherever /opt/homebrew/bin comes first on PATH.
brew "typescript-language-server"
brew "nnn"
# node — the default Node here. nvm is loaded (see zsh/zinit.zsh) but manages no
# versions, so this is what actually resolves. It was installed by hand and left
# undeclared, meaning `brew bundle` on a fresh box produced a shell with pnpm but
# no node; declare it so that stays reproducible.
brew "node"
brew "pnpm"
# direnv — per-directory environments, which here means a project's Nix dev
# shell: ghostty, rio and kennybdev each carry an .envrc saying `use flake`.
# The caching half, nix-direnv, is not a formula; .config/direnv/direnvrc
# fetches it pinned and checksummed. The zsh hook is the zcache line in .zshrc.
brew "direnv"
# vivid: see the fzf entry.
brew "vivid"
brew "imagemagick"
brew "nss"
brew "shfmt"
brew "shellcheck"
# stylua — Lua formatter. Declared here rather than left to Mason because
# .config/lvim wires it into none-ls, which shells out to PATH: a Mason copy
# would live under ~/.local/share and vanish with the editor's runtime.
brew "stylua"
# atuin — shell history. Back here after a stretch as a zinit gh-r binary. That
# move put zinit's plugin machinery on the startup critical path, and it left
# two copies installed once a Homebrew one landed anyway. On 2026-10-23 the
# launchd daemon ran the 18.24.2 Homebrew build while the shell hooks called
# zinit's 18.22.0, and the daemon rejected every `atuin history end`, so
# nothing was recorded for three days. One install, and /opt/homebrew/bin/atuin
# is a link that survives `brew upgrade`, so the daemon's plist stays valid.
# install.sh's sync_atuin_daemon keeps the plist on it. Ignore the formula's
# `brew services start atuin` caveat: atuin's autostart already runs the daemon
# as sh.atuin.daemon, and a brew service would be a second one on the same
# socket.
brew "atuin"
# starship — the prompt. Not installed here: zsh/zinit.zsh runs the official
# installer into ~/.local/bin the first time a shell finds it missing, so that
# script is its one updater. Declaring it here as well made `brew bundle
# check` fail on every machine where the installer had already run, and a
# `brew bundle install` would put a second copy on PATH. Left declared,
# commented, so the package isn't lost from this list.
# brew "starship"
brew "poppler"
brew "sevenzip"
# zstd — provides unzstd, which install.sh needs to unpack the pay-respects
# release (it ships .tar.zst only). Previously present merely as a transitive
# dep of curl/imagemagick/etc; declare it now that a script depends on it.
brew "zstd"
brew "helix"
brew "yazi"
brew "btop"
brew "fastfetch"
brew "firebase-cli"
brew "zig"
# iris — inline completion overlay (IntelliSense for the prompt). Config and
# theme live in .config/iris and are symlinked by install.sh; the autostart hook
# is in .zshrc. The tap is the author's own, and is the only distribution
# channel that isn't `curl | sh` or a self-updating binary — which is also why
# [updater] is switched off in config.toml: brew owns this binary, so letting
# iris rewrite its own Cellar path would desync `brew upgrade`.
brew "versenilvis/iris/iris"
